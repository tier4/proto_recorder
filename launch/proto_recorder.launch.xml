<?xml version="1.0"?>
<launch>
  <!-- Arguments for proto_recorder -->
  <arg name="uri" default="proto_recording" description="Output directory for recorded bag"/>
  <arg name="storage_id" default="mcap" description="Storage plugin to use"/>
  <arg name="topics" default="" description="List of topics to record (comma-separated)"/>
  <arg name="all" default="false" description="Record all topics"/>
  <arg name="serialization_format" default="cdr" description="Serialization format to use"/>
  <arg name="start_paused" default="false" description="Start recording in paused state"/>
  
  <!-- Storage configuration arguments -->
  <arg name="storage_config_uri" default="" description="Path to a YAML file defining storage specific configurations"/>
  <arg name="storage_preset_profile" default="" description="Storage preset profile (e.g., 'fastwrite', 'zstd_fast', 'zstd_small' for MCAP)"/>
  <arg name="max_bagfile_size" default="0" description="Maximum size in bytes before the bagfile will be split"/>
  <arg name="max_bagfile_duration" default="0" description="Maximum duration in seconds before the bagfile will be split"/>
  <arg name="max_cache_size" default="0" description="Maximum size of messages to hold in cache"/>
  
  <!-- Compression arguments -->
  <arg name="compression_mode" default="" description="Compression mode ('none', 'file', 'message')"/>
  <arg name="compression_format" default="" description="Compression format (e.g., 'zstd')"/>
  <arg name="compression_queue_size" default="1" description="Number of files/messages that may be queued for compression"/>
  <arg name="compression_threads" default="0" description="Number of compression threads (0 = number of CPU cores)"/>

  <!-- Launch the proto_recorder node with parameters -->
  <node pkg="proto_recorder" exec="proto_recorder_node" name="proto_recorder_node" output="screen">
    <param name="uri" value="$(var uri)"/>
    <param name="storage_id" value="$(var storage_id)"/>
    <param name="topics" value="$(var topics)"/>
    <param name="all" value="$(var all)"/>
    <param name="serialization_format" value="$(var serialization_format)"/>
    <param name="start_paused" value="$(var start_paused)"/>
    
    <!-- Storage configuration parameters -->
    <param name="storage_config_uri" value="$(var storage_config_uri)"/>
    <param name="storage_preset_profile" value="$(var storage_preset_profile)"/>
    <param name="max_bagfile_size" value="$(var max_bagfile_size)"/>
    <param name="max_bagfile_duration" value="$(var max_bagfile_duration)"/>
    <param name="max_cache_size" value="$(var max_cache_size)"/>
    
    <!-- Compression parameters -->
    <param name="compression_mode" value="$(var compression_mode)"/>
    <param name="compression_format" value="$(var compression_format)"/>
    <param name="compression_queue_size" value="$(var compression_queue_size)"/>
    <param name="compression_threads" value="$(var compression_threads)"/>
  </node>
</launch>
